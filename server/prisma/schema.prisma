// Brightloop Subscription Management System — data model.
// Money is stored as integer minor units (paise); percentages as basis points (1800 = 18.00%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  SOFTWARE_LICENSE
  ADDON
  GOODS
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum DiscountKind {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  ONLINE_SIMULATED
}

enum BillingTrigger {
  CRON
  MANUAL
}

enum BillingRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum EmailStatus {
  SENT
  FAILED
  LOGGED
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // stored lower-cased
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  customerId   Int?     @unique @map("customer_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer             Customer?            @relation(fields: [customerId], references: [id])
  resetTokens          PasswordResetToken[]
  createdSubscriptions Subscription[]       @relation("SubscriptionCreatedBy")
  payments             Payment[]
  activities           ActivityLog[]
  billingRuns          BillingRun[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  address   String?
  taxId     String?  @map("tax_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User?
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([name])
  @@index([email])
  @@map("customers")
}

// ───────────────────────── Catalogue ─────────────────────────

model Tax {
  id        Int      @id @default(autoincrement())
  name      String
  rateBp    Int      @map("rate_bp") // CHECK 0..10000 (migration)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products          Product[]
  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType
  salesPrice Int         @map("sales_price")
  costPrice  Int         @map("cost_price")
  notes      String?
  taxId      Int?        @map("tax_id")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tax               Tax?                    @relation(fields: [taxId], references: [id])
  variants          ProductVariant[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  discounts         Discount[]
  invoiceLines      InvoiceLine[]

  @@index([name])
  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  name       String // e.g. "Brand: Odoo"
  attributes Json     @default("{}")
  priceExtra Int      @default(0) @map("price_extra")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, name])
  @@map("product_variants")
}

model RecurringPlan {
  id              Int           @id @default(autoincrement())
  name            String
  price           Int           @default(0) // recurring base fee per period
  billingPeriod   BillingPeriod @map("billing_period")
  billingInterval Int           @default(1) @map("billing_interval")
  minQuantity     Int           @default(1) @map("min_quantity")
  availableFrom   DateTime?     @map("available_from") @db.Date
  availableTo     DateTime?     @map("available_to") @db.Date
  termLength      Int?          @map("term_length") // number of periods; null = open-ended
  autoClose       Boolean       @default(false) @map("auto_close")
  closable        Boolean       @default(true)
  pausable        Boolean       @default(false)
  renewable       Boolean       @default(true)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  templates     QuotationTemplate[]
  subscriptions Subscription[]

  @@map("recurring_plans")
}

model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  planId       Int      @map("plan_id")
  validityDays Int      @map("validity_days")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan          RecurringPlan           @relation(fields: [planId], references: [id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         Int  @id @default(autoincrement())
  templateId Int  @map("template_id")
  productId  Int  @map("product_id")
  variantId  Int? @map("variant_id")
  quantity   Int  @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("quotation_template_lines")
}

// ───────────────────────── Subscriptions ─────────────────────────

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique // SUB-000123 from a sequence
  customerId      Int                @map("customer_id")
  planId          Int                @map("plan_id")
  templateId      Int?               @map("template_id")
  status          SubscriptionStatus @default(DRAFT)
  quoteExpiresAt  DateTime?          @map("quote_expires_at") @db.Date
  startDate       DateTime           @map("start_date") @db.Date
  expiryDate      DateTime?          @map("expiry_date") @db.Date
  nextBillingDate DateTime?          @map("next_billing_date") @db.Date
  paymentTermDays Int                @default(15) @map("payment_term_days")
  notes           String?
  pausedAt        DateTime?          @map("paused_at")
  closedAt        DateTime?          @map("closed_at")
  closeReason     String?            @map("close_reason")
  version         Int                @default(0)
  createdById     Int?               @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  customer  Customer               @relation(fields: [customerId], references: [id])
  plan      RecurringPlan          @relation(fields: [planId], references: [id])
  template  QuotationTemplate?     @relation(fields: [templateId], references: [id])
  createdBy User?                  @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  lines     SubscriptionLine[]
  discounts SubscriptionDiscount[]
  invoices  Invoice[]

  // Partial index on next_billing_date WHERE status='ACTIVE' is added in raw SQL.
  @@index([status])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             Int     @id @default(autoincrement())
  subscriptionId Int     @map("subscription_id")
  productId      Int     @map("product_id")
  variantId      Int?    @map("variant_id")
  description    String
  quantity       Int
  unitPrice      Int     @map("unit_price") // sales price + variant extra at time of quoting
  taxId          Int?    @map("tax_id")

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax?            @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_lines")
}

// ───────────────────────── Discounts ─────────────────────────

model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique
  kind        DiscountKind
  value       Int // minor units for FIXED, basis points for PERCENT
  minPurchase Int?          @map("min_purchase")
  minQuantity Int?          @map("min_quantity")
  startsOn    DateTime?     @map("starts_on") @db.Date
  endsOn      DateTime?     @map("ends_on") @db.Date
  usageLimit  Int?          @map("usage_limit")
  usageCount  Int           @default(0) @map("usage_count") // CHECK usage_count <= usage_limit (migration)
  scope       DiscountScope
  productId   Int?          @map("product_id")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  product       Product?               @relation(fields: [productId], references: [id])
  subscriptions SubscriptionDiscount[]
  invoices      InvoiceDiscount[]

  @@map("discounts")
}

model SubscriptionDiscount {
  subscriptionId Int      @map("subscription_id")
  discountId     Int      @map("discount_id")
  attachedAt     DateTime @default(now()) @map("attached_at")
  attachedById   Int?     @map("attached_by")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discount     Discount     @relation(fields: [discountId], references: [id])

  @@id([subscriptionId, discountId])
  @@map("subscription_discounts")
}

// ───────────────────────── Invoicing ─────────────────────────

model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique // INV-2026-000123 from a sequence
  subscriptionId Int           @map("subscription_id")
  customerId     Int           @map("customer_id")
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Int
  discountTotal  Int           @default(0) @map("discount_total")
  taxTotal       Int           @default(0) @map("tax_total")
  total          Int
  amountPaid     Int           @default(0) @map("amount_paid")
  sentAt         DateTime?     @map("sent_at")
  billingRunId   Int?          @map("billing_run_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  subscription Subscription      @relation(fields: [subscriptionId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  billingRun   BillingRun?       @relation(fields: [billingRunId], references: [id])
  lines        InvoiceLine[]
  discounts    InvoiceDiscount[]
  payments     Payment[]

  // Partial UNIQUE (subscription_id, period_start) WHERE status <> 'CANCELLED' is added in raw SQL.
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int     @map("invoice_id")
  productId      Int?    @map("product_id")
  description    String
  quantity       Int
  unitPrice      Int     @map("unit_price")
  discountAmount Int     @default(0) @map("discount_amount")
  taxRateBp      Int     @default(0) @map("tax_rate_bp")
  taxAmount      Int     @default(0) @map("tax_amount")
  lineTotal      Int     @map("line_total")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoiceDiscount {
  invoiceId  Int @map("invoice_id")
  discountId Int @map("discount_id")
  amount     Int

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@id([invoiceId, discountId])
  @@map("invoice_discounts")
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int           @map("invoice_id")
  method       PaymentMethod
  amount       Int // CHECK > 0 (migration)
  paidOn       DateTime      @map("paid_on") @db.Date
  note         String?
  recordedById Int?          @map("recorded_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidOn])
  @@map("payments")
}

// ───────────────────────── Operations ─────────────────────────

model BillingRun {
  id             Int              @id @default(autoincrement())
  asOf           DateTime         @map("as_of") @db.Date
  trigger        BillingTrigger
  triggeredById  Int?             @map("triggered_by")
  status         BillingRunStatus @default(RUNNING)
  createdCount   Int              @default(0) @map("created_count")
  skippedCount   Int              @default(0) @map("skipped_count")
  failedCount    Int              @default(0) @map("failed_count")
  activatedCount Int              @default(0) @map("activated_count")
  closedCount    Int              @default(0) @map("closed_count")
  errors         Json             @default("[]")
  startedAt      DateTime         @default(now()) @map("started_at")
  finishedAt     DateTime?        @map("finished_at")

  triggeredBy User?     @relation(fields: [triggeredById], references: [id])
  invoices    Invoice[]

  // Partial UNIQUE (status) WHERE status = 'RUNNING' is added in raw SQL: at most one run at a time.
  @@index([startedAt])
  @@map("billing_runs")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  userId     Int?     @map("user_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("activity_log")
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  to        String
  subject   String
  kind      String
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("email_log")
}
