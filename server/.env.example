# Runtime connection: Supabase session pooler (port 5432). One round trip per query.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5"
# Migrations connection (session pooler or direct host)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"

SEED_ADMIN_EMAIL="admin@brightloop.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional SMTP; when unset, emails are written to the console and email_log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop Billing <billing@brightloop.test>"

BILLING_CRON_ENABLED="true"
BILLING_CRON="5 0 * * *"
